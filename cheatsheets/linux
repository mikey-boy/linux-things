#---- FILE SEARCHING ----#

updatedb			# Make sure you run updatedb prior to using
locate [filename]		# the locate command
which [filename]		# Checks directories located in $PATH, returns full path
find [dir] -name [filename]	# Recurively search. Regex allowed on filename

#---- SERVICES ----#

systemctl start [service] 	# Start specified service
systemctl enable [service]	# Start specified service at boot time

#---- FILESYSTEM ----#

fdisk /dev/sdX                              # Modify the partition table
pvresize /dev/sdXY                          # Resize a physical volume after enlarging the partition
lvextend -l +100%FREE /dev/mapper/[lvm]     # Extend lv (when there is space in the pv)
resize2fs /dev/mapper/[lvm]                 # Resize ext4 filesystem on lv

#---- NETWORK STATE ----#

ss -antl                # Display listening TCP sockets
ip addr list            # List network interfaces
ip route list           # List routing table
resolvectl status       # When using systemd-resolved, check the status
resolvectl dns          # Check the configured dns servers
iptables -L             # List all chains and rules
iptables -L -t nat      # List NAT rules
lsof -i tcp:80          # List process that has port 80 opened


#---- NETWORK MODIFICATIONS ----#

ip link set dev {DEVICE} {up|down}                  # Set device up or down

ip route add {X.X.X.X}/24 via X.X.X.X dev {DEVICE}  # Specify a new route
ip route delete default                             # Delete the default route
ip route add default via {X.X.X.X}                  # Add a default gateway

dhclient -r {DEVICE}                                # Release any lease you may have for this interface
dhclient -v -4 {DEVICE}                             # Acquire a new lease for this interface
dhcpcd -n {DEVICE}                                  # Acquire a new lease for this interface (using dhcpcd)

sudo vim /etc/systemd/resolved.conf                 # Modify systemd-resolved configuration

