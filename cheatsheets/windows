#
# Simple Windows Command Cheatsheet
#


#---- FILE SEARCHING ----#

Get-ChildItem "[filepath]" -include *.c -recurse        # Recursively search through path, returning matching files
Get-Content "[filepath]" -Tail 50 -Wait                 # Monitor the contents of a file

#---- UPDATING SYSTEM ----#

Get-WindowsUpdate -AcceptAll -Install -AutoReboot       # Download and install Windows updates, rebooting if necessary

#---- SERVICES ----#

Get-Service                                             # List all services on the system
Get-Service "*[keyword]*"                               # List services that contain keyword
Get-Service | Where-Object {$_.Status -eq "Running"}    # List running services

Start-Service "[service]"   # Start a service
Stop-Service "[service]"    # Stop a service

#---- NETWORKING ----#

netstat -anb                                            # Display all connections and listening ports, with associated executable
netstat -anp TCP                                        # Display all TCP connections and listening ports
netstat -anb | Select-String "LISTENING"                # Display all listening connections

#---- ACTIVE DIRECTORY ----#

Get-ADOrganizationalUnit -Filter *                      # Get Organization Unit info
New-ADUser -Name "Jane Doe"                             # Add new use to domain
    -GivenName "Jane" 
    -Surname "Doe"
    -SamAccountName "jdoe" 
    -UserPrincipalName "jdoe@contoso.local" 
    -Path "CN=Users,DC=contoso,DC=local" 
    -AccountPassword (ConvertTo-SecureString "Password123!" -AsPlainText -Force) 
    -Enabled $true

#---- MISC ----#

Get-FileHash -Path "[filepath]" -Algorithm SHA256       # Calculate the SHA256 sum of a file
Set-ExecutionPolicy unrestricted                        # Allow running arbitrary Powershell scripts
(Get-Item "C:\Windows\System32\<file>.dll").VersionInfo # Get the file version of a particular dll

