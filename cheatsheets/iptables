--- General ---

iptables -vL --line-numbers     # List all rules for table, show in and out interface
iptables -F		        # Flush all rules for builtin chains

--- Managing rules ---

iptables -P [chain] [target]	# Set default filter policy
iptables -D [chain] [rulenum]   # Drop a rule, specified by rulenum
iptables -A [chain]             # Append a rule to a chain
	 -i [interface] 
	 -j [target]

--- Example ---

iptables -I OUTPUT [pos] -d [ip]    # Insert rule into position 8 of a chain, allowing HTTPS traffic
         -p tcp --dport 443 
         -j ACCEPT

